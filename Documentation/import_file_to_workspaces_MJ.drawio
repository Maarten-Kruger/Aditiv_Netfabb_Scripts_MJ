<mxfile host="app.diagrams.net">
  <diagram name="Import to Workspaces Flow">
    <mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="start" value="Start" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="40" width="120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="input_dir" value="Input: Select Import Folder" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="140" width="120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="input_mach" value="Input: Machine Name" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="220" width="120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="get_id" value="Logic: Get Workspace ID" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="300" width="120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="loop_files" value="Loop: For Each File" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="380" width="120" height="80" as="geometry" />
        </mxCell>

        <mxCell id="check_cad" value="Is CAD?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="480" width="120" height="80" as="geometry" />
        </mxCell>

        <mxCell id="load_mesh" value="Logic: Create Workspace -> Load Mesh (STL/3MF)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="200" y="580" width="150" height="80" as="geometry" />
        </mxCell>

        <mxCell id="load_cad" value="Logic: Create Workspace -> Load CAD (STEP Params, Kernel 0-10)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="490" y="580" width="150" height="80" as="geometry" />
        </mxCell>

        <mxCell id="center" value="Logic: Center Mesh in Workspace" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="720" width="120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="end" value="End" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="820" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="start" target="input_dir">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="input_dir" target="input_mach">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="input_mach" target="get_id">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="get_id" target="loop_files">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="loop_files" target="check_cad">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="check_cad" target="load_mesh">
          <mxGeometry relative="1" as="geometry" />
          <mxText value="No" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e6">
            <mxGeometry x="-0.2" relative="1" as="geometry">
              <mxPoint as="offset" />
            </mxGeometry>
          </mxText>
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="check_cad" target="load_cad">
          <mxGeometry relative="1" as="geometry" />
           <mxText value="Yes" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e7">
            <mxGeometry x="-0.2" relative="1" as="geometry">
              <mxPoint as="offset" />
            </mxGeometry>
          </mxText>
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="load_mesh" target="center">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="275" y="690" />
              <mxPoint x="420" y="690" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="load_cad" target="center">
           <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="565" y="690" />
              <mxPoint x="420" y="690" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="center" target="loop_files">
           <mxGeometry relative="1" as="geometry">
             <Array as="points">
              <mxPoint x="680" y="750" />
              <mxPoint x="680" y="420" />
            </Array>
          </mxGeometry>
           <mxText value="Next File" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e10">
            <mxGeometry x="-0.2" relative="1" as="geometry">
              <mxPoint as="offset" />
            </mxGeometry>
          </mxText>
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="loop_files" target="end">
           <mxGeometry relative="1" as="geometry">
             <Array as="points">
              <mxPoint x="180" y="420" />
              <mxPoint x="180" y="850" />
            </Array>
          </mxGeometry>
           <mxText value="Done" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e11">
            <mxGeometry x="-0.2" relative="1" as="geometry">
              <mxPoint as="offset" />
            </mxGeometry>
          </mxText>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
