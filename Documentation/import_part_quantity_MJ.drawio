<mxfile host="app.diagrams.net">
  <diagram name="Import Part Quantity Flow">
    <mxGraphModel dx="1000" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="start" value="Start" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="40" width="120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="input_dir" value="Input: Select Import Folder" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="140" width="120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="input_settings" value="Input: Import Settings" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="220" width="120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="create_ws" value="Logic: Create Single Workspace" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="300" width="120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="find_csv" value="Logic: Find CSV / Manual Paste" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="380" width="120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="parse" value="Logic: Parse CSV (Name, Num, Qty)" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="460" width="120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="loop_rows" value="Loop: For Each Row" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="540" width="120" height="80" as="geometry" />
        </mxCell>

        <mxCell id="file_check" value="Check: File Exists?" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="640" width="120" height="80" as="geometry" />
        </mxCell>

        <mxCell id="loop_qty" value="Loop: Quantity Times" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="640" width="120" height="80" as="geometry" />
        </mxCell>

        <mxCell id="add_mesh" value="Logic: Add Mesh &amp; Center" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="650" width="120" height="60" as="geometry" />
        </mxCell>

        <mxCell id="end" value="End" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="800" width="120" height="60" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="start" target="input_dir">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="input_dir" target="input_settings">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="input_settings" target="create_ws">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="create_ws" target="find_csv">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="find_csv" target="parse">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="parse" target="loop_rows">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="loop_rows" target="file_check">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="file_check" target="loop_qty">
          <mxGeometry relative="1" as="geometry" />
           <mxText value="Yes" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e8">
            <mxGeometry x="-0.2" relative="1" as="geometry">
              <mxPoint as="offset" />
            </mxGeometry>
          </mxText>
        </mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="loop_qty" target="add_mesh">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="add_mesh" target="loop_qty">
           <mxGeometry relative="1" as="geometry">
             <Array as="points">
              <mxPoint x="780" y="620" />
              <mxPoint x="600" y="620" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="loop_qty" target="loop_rows">
           <mxGeometry relative="1" as="geometry">
             <Array as="points">
              <mxPoint x="600" y="740" />
              <mxPoint x="420" y="740" />
              <mxPoint x="420" y="630" />
            </Array>
          </mxGeometry>
           <mxText value="Done" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e11">
            <mxGeometry x="-0.2" relative="1" as="geometry">
              <mxPoint as="offset" />
            </mxGeometry>
          </mxText>
        </mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="file_check" target="loop_rows">
           <mxGeometry relative="1" as="geometry">
             <Array as="points">
              <mxPoint x="340" y="680" />
              <mxPoint x="340" y="580" />
            </Array>
          </mxGeometry>
           <mxText value="No" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e12">
            <mxGeometry x="-0.2" relative="1" as="geometry">
              <mxPoint as="offset" />
            </mxGeometry>
          </mxText>
        </mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" edge="1" parent="1" source="loop_rows" target="end">
           <mxGeometry relative="1" as="geometry">
             <Array as="points">
              <mxPoint x="280" y="580" />
              <mxPoint x="280" y="830" />
            </Array>
          </mxGeometry>
           <mxText value="Done" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" vertex="1" connectable="0" parent="e13">
            <mxGeometry x="-0.2" relative="1" as="geometry">
              <mxPoint as="offset" />
            </mxGeometry>
          </mxText>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
